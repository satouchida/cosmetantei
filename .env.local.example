# 秘密情報（AI Gateway の認証トークン CF_AIG_TOKEN）は .env 系のファイル（.env.local / .env.development.local など）に書かないでください。
# Cloudflare ビルド（opennextjs-cloudflare build）が全モードの .env ファイルを Worker に埋め込みます。
# 設定場所:
#   pnpm dev / wrangler dev / opennextjs-cloudflare preview:  .dev.vars（.dev.vars.example をコピー）
#   本番:                                                        pnpm exec wrangler secret put CF_AIG_TOKEN
# Gemini の APIキーは AI Gateway の Provider Keys に保存しており、アプリでは扱いません。

# 使用するGeminiモデル (デフォルト: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Amazonアソシエイト・アフィリエイトID (デフォルト: cosmetantei-22)
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG="cosmetantei-22"
