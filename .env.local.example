# GEMINI_API_KEY は .env 系のファイル（.env.local / .env.development.local など）に書かないでください。
# Cloudflare ビルド（opennextjs-cloudflare build）が全モードの .env ファイルを Worker に埋め込みます。
# APIキーの設定場所:
#   npm run dev / wrangler dev / opennextjs-cloudflare preview:  .dev.vars（.dev.vars.example をコピー）
#   本番:                                                        npx wrangler secret put GEMINI_API_KEY

# 使用するGeminiモデル (デフォルト: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Amazonアソシエイト・アフィリエイトID (デフォルト: cosmetantei-22)
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG="cosmetantei-22"
