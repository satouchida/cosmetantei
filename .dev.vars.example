# pnpm dev / wrangler dev / opennextjs-cloudflare preview 用のローカル環境変数（このファイルを .dev.vars にコピーして値を設定）
# Gemini と Clef は Cloudflare AI Gateway 経由で呼び出します。Gemini の APIキーは AI Gateway の Provider Keys に保存済みです

# AI Gateway の認証トークン（ダッシュボードの「Create authentication token」で発行。秘密情報）
CF_AIG_TOKEN="YOUR_CF_AIG_TOKEN"

# ローカルでは開発用ゲートウェイを使う（wrangler.toml の cosmetantei-prod を上書き）
CF_ACCOUNT_ID="abd3843a83776fc9f73f65bb4bc2265e"
AI_GATEWAY_ID="cosmetantei-dev"

# 開発用ゲートウェイではプロンプト・応答本文もログに残す（本番は残さない）
AI_GATEWAY_LOG_PAYLOAD="true"

# お店の価格（docs/plans/shop-prices.md）。未設定のお店は、商品ページを読んで調べます
# 楽天ウェブサービスのアプリ ID とアクセスキー（秘密情報。本番は wrangler secret put）
RAKUTEN_APPLICATION_ID="YOUR_RAKUTEN_APPLICATION_ID"
RAKUTEN_ACCESS_KEY="YOUR_RAKUTEN_ACCESS_KEY"
# Yahoo!デベロッパーネットワークの Client ID（本番は wrangler secret put）
YAHOO_CLIENT_ID="YOUR_YAHOO_CLIENT_ID"
